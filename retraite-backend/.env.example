DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/retraite_db
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
RESERVATION_AMOUNT=5000000

DEV_EMAIL=ton.email@exemple.com
DEV_PASSWORD=ChangeMoi123!

ADMIN_EMAIL=ecoretraite@gmail.com
ADMIN_PASSWORD=ChangeMoi123!

# Assistant IA (client + admin) - API Anthropic
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5

LOG_DIR=logs

# Adresse publique du serveur, écrite dans le QR code des reçus (ex. https://retraite-api.up.railway.app).
# Pour qu'un téléphone puisse scanner et vérifier un reçu, elle doit être joignable depuis Internet.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Lien Play Store de l'appli : s'il est rempli, un 2e QR code "Télécharger l'application" apparaît sur le reçu.
APP_DOWNLOAD_URL=

# Envoi d'emails pour "Mot de passe oublié" (exemple Gmail avec un mot de passe d'application).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Développement uniquement : si aucun SMTP n'est configuré, le code est écrit dans la fenêtre du serveur.
RESET_CODE_IN_LOGS=false

# --- Docker (docker compose) ---
# Mots de passe de la base MySQL créée par docker compose (choisis-en de longs et uniques).
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Nom de domaine pour le HTTPS automatique (profil "https"), ex. retraite.duckdns.org
DOMAIN=
